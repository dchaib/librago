{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "mcr.microsoft.com/dotnet/sdk"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": [
        "Microsoft.Playwright",
        "mcr.microsoft.com/playwright/dotnet"
      ],
      "groupName": "Playwright",
      "minimumGroupSize": 2
    }
  ]
}
