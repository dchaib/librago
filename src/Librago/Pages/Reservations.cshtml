@page
@model Librago.Pages.ReservationsModel
@using Librago.Reservations
@using Librago.Synchronization
@{
    ViewData["Title"] = "Mes réservations";
}

<header class="hero">
    <p class="eyebrow">Librago</p>
    <h1>Mes réservations</h1>
    <p class="hero__subtitle">Les réservations de toute la famille, prêtes à retirer en priorité.</p>
</header>

@if (!Model.HasConfiguredAccounts)
{
    <section class="notice notice--info" role="status">
        <strong>Aucun compte n’est configuré.</strong>
        <span>Ajoutez vos comptes dans la configuration locale pour lancer la première synchronisation.</span>
    </section>
}

@foreach (var status in Model.NetworkStatuses.Where(status => status.NeedsAttention))
{
    <section class="notice notice--warning" role="status">
        <strong>@status.NetworkName</strong>
        @if (status.LastCompleteSuccessAt is null)
        {
            <span>Les réservations de ce réseau n’ont encore jamais été synchronisées complètement avec succès.</span>
            @if (status.Result is SynchronizationResult.Partial)
            {
                <span>La dernière synchronisation est partielle. Les comptes actualisés restent consultables.</span>
            }
        }
        else
        {
            @if (!status.HasCurrentAccountCoverage)
            {
                <span>La configuration des comptes a changé depuis la dernière actualisation complète.</span>
            }
            @if (status.Result is SynchronizationResult.Partial)
            {
                <span>La dernière synchronisation est partielle. Les réservations précédentes des comptes en échec sont conservées.</span>
            }
            else if (status.Result is SynchronizationResult.Failed)
            {
                <span>La dernière synchronisation a échoué. L’ancien état reste affiché.</span>
            }
            @if (status.IsStale)
            {
                <span>Ces informations datent de plus de 24 heures.</span>
            }
        }
    </section>
}

@if (Model.HasConfiguredAccounts)
{
    <form method="get" class="filters" aria-label="Filtrer les réservations">
        <label>
            <span>Réseau</span>
            <select asp-for="SelectedNetwork" asp-items="Model.NetworkOptions">
                <option value="">Tous les réseaux</option>
            </select>
        </label>
        <label>
            <span>Emprunteur</span>
            <select asp-for="SelectedBorrower" asp-items="Model.BorrowerOptions">
                <option value="">Toute la famille</option>
            </select>
        </label>
        <label>
            <span>Bibliothèque de retrait</span>
            <select asp-for="SelectedPickupLibrary" asp-items="Model.PickupLibraryOptions"><option value="">Toutes les bibliothèques</option></select>
        </label>
        <label>
            <span>État</span>
            <select asp-for="SelectedStatus" asp-items="Model.StatusOptions"><option value="">Tous les états</option></select>
        </label>
        <button type="submit">Filtrer</button>
        @if (Model.HasActiveFilters)
        {
            <a asp-page="/Reservations" class="filters__reset">Effacer</a>
        }
    </form>
}

@if (Model.HasConfiguredAccounts && Model.Reservations.Count == 0)
{
    <section class="empty-state">
        @if (Model.HasActiveFilters)
        {
            <h2>Aucune réservation ne correspond à ces filtres</h2>
            <p>Modifiez les filtres ou affichez de nouveau toutes les réservations.</p>
        }
        else if (Model.NetworkStatuses.Count > 0 && Model.NetworkStatuses.All(status => !status.NeedsAttention))
        {
            <h2>Aucune réservation en cours</h2>
            <p>Aucune réservation en cours après la dernière synchronisation.</p>
        }
        else if (Model.NetworkStatuses.Any(status => status.LastCompleteSuccessAt is not null))
        {
            <h2>Aucune réservation dans le dernier état connu</h2>
            <p>La synchronisation a besoin d’attention. Consultez les indications d’actualisation.</p>
        }
        else
        {
            <h2>Les réservations ne sont pas encore disponibles</h2>
            <p>La première synchronisation est en cours ou a besoin d’attention.</p>
        }
    </section>
}

@if (Model.Reservations.Count > 0)
{
    <p class="result-count">@Model.Reservations.Count @(Model.Reservations.Count == 1 ? "réservation" : "réservations")</p>
    <ol class="loan-list">
        @foreach (var reservation in Model.Reservations)
        {
            <partial name="_ReservationCard" model="new ReservationCardViewModel(reservation, Model.Today)" />
        }
    </ol>
}

@if (Model.NetworkStatuses.Count > 0)
{
    @if (Model.Reservations.Any(r => r.Item.ReservedOn is null || r.AvailableOn is not null && r.Item.AvailableOn is null))
    {
        <p id="estimated-dates" class="estimate-explanation">* Date estimée d’après la première observation par Librago. Elle peut être postérieure à la date réelle, notamment lors de la première utilisation ou après une interruption de synchronisation.</p>
    }
    <footer class="sync-status">
        <h2>Actualisation des données</h2>
        <ul>
            @foreach (var status in Model.NetworkStatuses)
            {
                <li>
                    <strong>@status.NetworkName</strong>
                    @if (status.LastCompleteSuccessAt is null)
                    {
                        <span>Jamais actualisé complètement</span>
                    }
                    else
                    {
                        <span>Dernière actualisation complète le @Model.FormatSynchronizationTime(status.LastCompleteSuccessAt.Value)</span>
                    }
                </li>
            }
        </ul>
    </footer>
}

